<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In</title>
  <link rel="stylesheet" href="/ui.css">
</head>
<body>
  <main class="app-shell">
    <h1>Sign In</h1>
    <p>Access your wallet dashboard.</p>

    <form class="stack">
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" placeholder="Enter username" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Enter password" required>
      </div>
      <div class="btn-row">
        <button id="loginBtn" class="btn btn-primary" type="submit">Sign In</button>
        <a class="link-btn link-btn-secondary" href="/signup">Need an account?</a>
      </div>
    </form>

    <div id="msg" class="message info">Enter your credentials.</div>

    <div class="nav">
      <a href="/">Back to Home</a>
    </div>
  </main>
  <script src="/loginScript.js"></script>
</body>
</html>
