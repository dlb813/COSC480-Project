<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up</title>
  <link rel="stylesheet" href="/ui.css">
</head>
<body>
  <main class="app-shell">
    <h1>Sign Up</h1>
    <p>Create your account to use wallet and transfer tools.</p>

    <form class="stack">
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" placeholder="Choose username" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Choose password" required>
      </div>
      <div class="btn-row">
        <button id="signupBtn" class="btn btn-primary" type="submit">Create Account</button>
        <a class="link-btn link-btn-secondary" href="/login">Already have an account?</a>
      </div>
    </form>

    <div id="msg" class="message info">Create a username and password.</div>

    <div class="nav">
      <a href="/">Back to Home</a>
    </div>
  </main>
  <script src="/signupScript.js"></script>
</body>
</html>
